{
  "name": "@orkestrator/web-public",
  "version": "2.15.16",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx tsc && bunx vite build",
    "dev": "bunx vite --host 127.0.0.1 --port 1422",
    "preview": "bunx vite preview --port 4422",
    "test": "bun test src --parallel",
    "test:workspace": "bun test src --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/web-public.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-2}",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@orkestrator/protocol": "workspace:*",
    "@orkestrator/web": "workspace:*",
    "lucide-react": "^0.562.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}

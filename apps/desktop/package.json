{
  "name": "@orkestrator/desktop",
  "version": "2.19.11",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/dev.ts",
    "dev:test": "bun scripts/dev-test.ts",
    "dev:status": "bun scripts/dev-status.ts",
    "dev:stop": "bun scripts/dev-stop.ts",
    "dev:reset": "bun scripts/dev-reset.ts",
    "dev:prune": "bun scripts/dev-prune.ts",
    "docker:build:dev": "bun scripts/dev-build-image.ts",
    "test": "bun test --preload ../../tests/setup-node.ts ./electron/agent-platform-selection.test.ts ./electron/application-logging.test.ts ./electron/auto-update.test.ts ./electron/macos-permissions.test.ts ./electron/runtime-profile.test.ts ./scripts/electron-bundle.test.ts ./scripts/dev --parallel",
    "test:workspace": "bun test --preload ../../tests/setup-node.ts ./electron/agent-platform-selection.test.ts ./electron/application-logging.test.ts ./electron/auto-update.test.ts ./electron/macos-permissions.test.ts ./electron/runtime-profile.test.ts ./scripts/electron-bundle.test.ts ./scripts/dev --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/desktop.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-2}",
    "typecheck": "bunx tsc --noEmit -p tsconfig.electron.json && bunx tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@orkestrator/backend": "workspace:*",
    "@orkestrator/protocol": "workspace:*",
    "@orkestrator/toolchain": "workspace:*",
    "@orkestrator/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.7",
    "electron": "^42.11.5",
    "electron-updater": "6.8.10",
    "typescript": "~7.0.2"
  }
}

{
  "version": 1,
  "cooperativeCommands": [
    "mise run test",
    "mise run test:slow",
    "mise run test:full",
    "mise run test:all",
    "mise run test:changed"
  ],
  "commandProfiles": {
    "mise run test:agent:browser:isolated": {
      "resources": ["workspace:*"],
      "workers": 2,
      "memoryMiB": 3072,
      "noProgressTimeoutMs": 300000,
      "covers": ["mise run test:agent:design:isolated"]
    },
    "mise run test:agent:design:isolated": {
      "resources": ["workspace:*"],
      "workers": 2,
      "memoryMiB": 3072,
      "noProgressTimeoutMs": 300000
    },
    "mise run test:changed": {
      "resources": ["workspace:build-outputs"]
    },
    "mise run test": {
      "resources": ["workspace:build-outputs"],
      "covers": ["mise run test:changed"]
    },
    "mise run test:slow": {
      "resources": ["workspace:build-outputs"]
    },
    "mise run test:full": {
      "resources": ["workspace:build-outputs"],
      "covers": ["mise run test", "mise run test:slow", "mise run test:changed"]
    },
    "mise run test:all": {
      "resources": ["workspace:build-outputs"],
      "covers": [
        "mise run test:full",
        "mise run test",
        "mise run test:slow",
        "mise run test:changed"
      ]
    },
    "mise run format:check": {
      "resources": [],
      "workers": 1,
      "memoryMiB": 256
    },
    "mise run lint": {
      "resources": [],
      "workers": 1,
      "memoryMiB": 512
    },
    "mise run typecheck": {
      "resources": []
    },
    "mise tasks validate": {
      "resources": [],
      "workers": 1,
      "memoryMiB": 128
    },
    "mise run test:browser": {
      "resources": ["host:tcp:1422", "host:tcp:4423", "workspace:output/playwright"],
      "workers": 8,
      "minWorkers": 4
    },
    "mise run test:logged -- --name browser -- mise run test:browser": {
      "resources": ["host:tcp:1422", "host:tcp:4423", "workspace:output/playwright"],
      "workers": 8,
      "minWorkers": 4
    }
  }
}

{
  "name": "orkestrator",
  "version": "2.8.2",
  "description": "Run the Orkestrator backend service without the desktop application",
  "type": "module",
  "bin": {
    "orkestrator": "bin/orkestrator.js"
  },
  "files": [
    "bin/",
    "dist/",
    "resources/",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "smoke:pack": "bun scripts/smoke-packed.ts",
    "test": "bun run build && bun test tests --parallel",
    "test:workspace": "bun test tests --parallel=${ORKESTRATOR_TEST_WORKERS:-2}",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "//dependencies": "Only modules scripts/build.ts leaves unbundled belong here; everything else is inlined into dist/ and resources/. tests/cli.test.ts derives this list from the built artifacts and fails if it drifts.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.228",
    "sharp": "0.35.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orkestrator-ai/orkestrator-v2.git",
    "directory": "packages/cli"
  },
  "homepage": "https://orkestrator.dev"
}

{
  "name": "claude-bridge",
  "version": "2.16.2",
  "description": "Bridge server for Claude Agent SDK integration with Orkestrator AI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --external @anthropic-ai/claude-agent-sdk --outfile=dist/index.js && bun run vendor",
    "test:bridge": "bun test src --preload ../../tests/setup-node.ts --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/claude-bridge.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-1}",
    "vendor": "bun scripts/vendor.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@anthropic-ai/sdk": "0.128.0",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@orkestrator/protocol": "workspace:*",
    "hono": "^4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}

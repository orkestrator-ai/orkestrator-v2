{
  "name": "orkestrator-ai",
  "version": "2.15.4",
  "private": true,
  "workspaces": [
    "apps/*",
    "bridges/*",
    "packages/*"
  ],
  "type": "module",
  "main": "apps/desktop/dist/electron/main.js",
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@happy-dom/global-registrator": "^20.1.0",
    "@orkestrator/protocol": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/bun": "~1.4.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/tar-stream": "3.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.18.4",
    "tar-stream": "3.2.0",
    "turbo": "^2.8.20",
    "typescript": "~5.8.3"
  },
  "packageManager": "bun@1.4.2",
  "build": {
    "appId": "com.orkestrator.v2",
    "productName": "OrkestratorV2",
    "directories": {
      "buildResources": "apps/desktop/electron/resources",
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false
    },
    "files": [
      "apps/desktop/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bridges/claude-bridge",
        "to": "claude-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/codex-bridge",
        "to": "codex-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/acp-bridge",
        "to": "acp-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/pi-bridge",
        "to": "pi-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/cursor-bridge",
        "to": "cursor-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "binaries",
        "to": "bin",
        "filter": [
          "bun"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Development",
      "executableName": "orkestrator-v2",
      "icon": "icons"
    }
  },
  "patchedDependencies": {
    "@opencode-ai/sdk@1.18.29": "patches/@opencode-ai%2Fsdk@1.18.29.patch"
  }
}

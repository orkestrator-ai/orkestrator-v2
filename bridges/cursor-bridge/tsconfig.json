{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  // Mirrors the ACP bridge: the shipped source builds with `--target=node`, so
  // Bun's ambient globals must stay out of this project. The test harness is
  // the one non-`.test.ts` file that needs them and is checked by
  // `tsconfig.test.json` instead.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/testing/**"]
}

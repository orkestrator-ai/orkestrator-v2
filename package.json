{
  "name": "orkestrator-ai",
  "version": "2.16.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "bridges/*",
    "packages/*"
  ],
  "type": "module",
  "main": "apps/desktop/dist/electron/main.js",
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@orkestrator/protocol": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "~1.4.2",
    "@types/node": "^25.9.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "3.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.11.5",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.68.0",
    "oxlint": "~1.78.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.13",
    "tar-stream": "3.2.1",
    "turbo": "^2.10.13",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "dompurify": "3.4.15"
  },
  "packageManager": "bun@1.4.2",
  "build": {
    "appId": "com.orkestrator.v2",
    "productName": "OrkestratorV2",
    "directories": {
      "buildResources": "apps/desktop/electron/resources",
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false
    },
    "files": [
      "apps/desktop/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bridges/claude-bridge",
        "to": "claude-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/codex-bridge",
        "to": "codex-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/acp-bridge",
        "to": "acp-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/pi-bridge",
        "to": "pi-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/cursor-bridge",
        "to": "cursor-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "binaries",
        "to": "bin",
        "filter": [
          "bun"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSAppleMusicUsageDescription": "Orkestrator checks Music and media-library access at startup so agent searches are not interrupted later.",
        "NSDesktopFolderUsageDescription": "Orkestrator searches project directories on your behalf so agents can work with files on the Desktop.",
        "NSDocumentsFolderUsageDescription": "Orkestrator searches project directories on your behalf so agents can work with files in Documents.",
        "NSDownloadsFolderUsageDescription": "Orkestrator searches project directories on your behalf so agents can work with files in Downloads.",
        "NSPhotoLibraryUsageDescription": "Orkestrator checks Pictures, Movies, and Photos-library access at startup so agent searches are not interrupted later."
      },
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Development",
      "executableName": "orkestrator-v2",
      "icon": "icons"
    }
  },
  "patchedDependencies": {
    "@opencode-ai/sdk@1.18.31": "patches/@opencode-ai%2Fsdk@1.18.31.patch",
    "@cursor/sdk@1.0.31": "patches/@cursor%2Fsdk@1.0.31.patch"
  }
}

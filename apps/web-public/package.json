{
  "name": "@orkestrator/web-public",
  "version": "2.34.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun check && bunx vite build",
    "dev": "bunx vite --host 127.0.0.1 --port 1422",
    "preview": "bunx vite preview --port 4422",
    "test": "bun test src --parallel",
    "test:workspace": "bun ../../scripts/bun-test-tier.ts apps/web-public src -- --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/web-public.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-2}",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@orkestrator/protocol": "workspace:*",
    "@orkestrator/web": "workspace:*",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}

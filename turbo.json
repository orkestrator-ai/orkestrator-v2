{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:workspace": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/tests/register-dom.ts",
        "$TURBO_ROOT$/tests/setup.ts",
        "$TURBO_ROOT$/tests/setup-node.ts"
      ],
      "outputs": [],
      "passThroughEnv": ["ORKESTRATOR_TEST_WORKERS", "ORKESTRATOR_TEST_TIMINGS_DIR"]
    },
    "test:bridge": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/tests/register-dom.ts",
        "$TURBO_ROOT$/tests/setup.ts"
      ],
      "outputs": [],
      "passThroughEnv": ["ORKESTRATOR_TEST_WORKERS", "ORKESTRATOR_TEST_TIMINGS_DIR"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["SSH_AUTH_SOCK"]
    },
    "dev:web": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ORKESTRATOR_*", "SSH_AUTH_SOCK", "VITE_DEV_HOST"]
    },
    "start:web": {
      "dependsOn": ["build", "@orkestrator/web#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ORKESTRATOR_*", "SSH_AUTH_SOCK"]
    },
    "start:web-public": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ORKESTRATOR_*", "SSH_AUTH_SOCK"]
    }
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "promise"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.1"
    }
  },
  "ignorePatterns": [
    "bridges/codex-bridge/src/app-server/generated/**",
    "test-fixtures/**",
    "output/**",
    "binaries/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-control-regex": "off",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/immutability": "error",
    "react/preserve-manual-memoization": "error",
    "react/globals": "error",
    "react/purity": "error",
    "react/use-memo": "error",
    "import/no-cycle": "error",
    "import/no-mutable-exports": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "console",
        "message": "Use createLogger from @orkestrator/protocol/logger (docs/architecture/logging.md)."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@orkestrator/protocol/testing/*"],
            "message": "Test fixtures and fakes are for tests only."
          }
        ]
      }
    ]
  },

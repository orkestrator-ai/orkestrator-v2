{
  "version": 1,
  "cooperativeCommands": [
    "mise run test",
    "mise run test:logged -- --name review-default-tests -- mise run test",
    "mise run test:slow",
    "mise run test:full",
    "mise run test:all",
    "mise run test:changed"
  ],
  "commandProfiles": {
    "mise run test:agent:docker:isolated": {
      "resources": ["workspace:*"],
      "workers": 4,
      "memoryMiB": 8192,
      "noProgressTimeoutMs": 600000,
      "covers": ["mise run test:agent:docker"],
      "onDemand": {
        "when": [
          "docker/**",
          "apps/backend/src/core/container-*",
          "apps/backend/src/core/commands-container*",
          "apps/backend/src/core/egress-gateway*",
          "e2e/agent-testing/**",
          "apps/desktop/scripts/dev-test*",
          "apps/desktop/scripts/test-agent-browser-isolated.ts",
          "apps/desktop/scripts/dev/isolated-browser.ts"
        ]
      }
    },
    "mise run test:agent:browser:isolated": {
      "resources": ["workspace:*"],
      "workers": 2,
      "memoryMiB": 3072,
      "noProgressTimeoutMs": 300000,
      "covers": ["mise run test:agent:design:isolated"],
      "onDemand": {
        "when": [
          "e2e/agent-testing/**",
          "apps/desktop/scripts/dev-test*",
          "apps/desktop/scripts/test-agent-browser-isolated.ts"
        ]
      }
    },
    "mise run test:agent:design:isolated": {
      "resources": ["workspace:*"],
      "workers": 2,
      "memoryMiB": 3072,
      "noProgressTimeoutMs": 300000,
      "onDemand": {
        "when": [
          "e2e/agent-testing/**",
          "apps/desktop/scripts/dev-test*",
          "apps/desktop/scripts/test-agent-browser-isolated.ts"
        ]
      }
    },
    "mise run test:package:security": {
      "resources": ["workspace:build-outputs", "workspace:release"],
      "workers": 2,
      "memoryMiB": 4096,
      "noProgressTimeoutMs": 600000,
      "onDemand": {
        "when": [
          "package.json",
          "electron-builder*.ts",
          "apps/desktop/electron/main.ts",
          "apps/desktop/electron/dev-mode.ts",
          "scripts/packaged-security.ts",
          "scripts/verify-packaged-security.ts",
          "e2e/agent-testing/packaged-security-electron.spec.ts"
        ]
      }
    },
    "mise run test:changed": {
      "resources": ["workspace:build-outputs"]
    },
    "mise run test": {
      "resources": ["workspace:build-outputs"],
      "covers": ["mise run test:changed"]
    },
    "mise run test:logged -- --name review-default-tests -- mise run test": {
      "resources": ["workspace:build-outputs"],
      "covers": ["mise run test", "mise run test:changed"]
    },
    "mise run test:slow": {
      "resources": ["workspace:build-outputs"],
      "onDemand": {
        "when": ["scripts/test-tiers.ts", "scripts/test-all.ts"]
      }
    },
    "mise run test:full": {
      "resources": ["workspace:build-outputs"],
      "covers": ["mise run test", "mise run test:slow", "mise run test:changed"],
      "onDemand": {
        "when": ["scripts/test-tiers.ts", "scripts/test-all.ts"],
        "instead": "mise run test"
      }
    },
    "mise run test:all": {
      "resources": ["workspace:build-outputs"],
      "covers": [
        "mise run test:full",
        "mise run test",
        "mise run test:slow",
        "mise run test:changed"
      ],
      "onDemand": {
        "when": ["scripts/test-tiers.ts", "scripts/test-all.ts", "apps/ios/**"],
        "instead": "mise run test"
      }
    },
    "mise run format:check": {
      "resources": [],
      "workers": 1,
      "memoryMiB": 256
    },
    "mise run lint": {
      "resources": [],
      "workers": 1,
      "memoryMiB": 512
    },
    "mise run typecheck": {
      "resources": []
    },
    "mise tasks validate": {
      "resources": [],
      "workers": 1,
      "memoryMiB": 128
    },
    "mise run test:browser": {
      "resources": ["host:tcp:1422", "host:tcp:4423", "workspace:output/playwright"],
      "workers": 8,
      "minWorkers": 4
    },
    "mise run test:logged -- --name browser -- mise run test:browser": {
      "resources": ["host:tcp:1422", "host:tcp:4423", "workspace:output/playwright"],
      "workers": 8,
      "minWorkers": 4
    }
  }
}

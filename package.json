{
  "name": "orkestrator-ai",
  "version": "2.12.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "bridges/*",
    "packages/*"
  ],
  "type": "module",
  "main": "apps/desktop/dist/electron/main.js",
  "scripts": {
    "dev": "turbo --cwd . run dev --filter=@orkestrator/desktop --cache-dir .turbo",
    "dev:test": "bun apps/desktop/scripts/dev-test.ts",
    "dev:status": "bun apps/desktop/scripts/dev-status.ts",
    "dev:login": "bun apps/desktop/scripts/dev-login.ts",
    "dev:stop": "bun apps/desktop/scripts/dev-stop.ts",
    "dev:reset": "bun apps/desktop/scripts/dev-reset.ts",
    "dev:web": "turbo run dev:web --cwd . --filter=@orkestrator/web --filter=@orkestrator/backend --cache-dir .turbo",
    "dev:web-public": "turbo --cwd . run dev --filter=@orkestrator/web-public --cache-dir .turbo",
    "dev:renderer": "turbo --cwd . run dev --filter=@orkestrator/web --cache-dir .turbo",
    "dev:ios": "bun scripts/run-ios-simulator.ts",
    "start:web": "turbo run start:web --cwd . --filter=@orkestrator/backend --cache-dir .turbo",
    "start:web-public": "turbo run start:web-public --cwd . --filter=@orkestrator/backend --cache-dir .turbo",
    "build": "turbo --cwd . run build --filter=@orkestrator/desktop --cache-dir .turbo",
    "build:desktop": "turbo --cwd . run build --filter=@orkestrator/desktop --cache-dir .turbo",
    "build:backend": "turbo --cwd . run build --filter=@orkestrator/backend --cache-dir .turbo",
    "build:cli": "turbo --cwd . run build --filter=orkestrator --cache-dir .turbo",
    "build:renderer": "turbo --cwd . run build --filter=@orkestrator/web --cache-dir .turbo",
    "build:web-public": "turbo --cwd . run build --filter=@orkestrator/web-public --cache-dir .turbo",
    "build:electron": "turbo --cwd . run build --filter=@orkestrator/desktop --cache-dir .turbo",
    "build:claude-bridge": "turbo --cwd . run build --filter=claude-bridge --cache-dir .turbo",
    "build:codex-bridge": "turbo --cwd . run build --filter=codex-bridge --cache-dir .turbo",
    "build:acp-bridge": "turbo --cwd . run build --filter=acp-bridge --cache-dir .turbo",
    "build:pi-bridge": "turbo --cwd . run build --filter=pi-bridge --cache-dir .turbo",
    "build:cursor-bridge": "turbo --cwd . run build --filter=cursor-bridge --cache-dir .turbo",
    "download:bun": "./scripts/download-bun.sh",
    "download:agent": "bun scripts/download-agent.ts",
    "download:claude": "bun scripts/download-agent.ts claude",
    "download:opencode": "bun scripts/download-agent.ts opencode",
    "download:codex": "bun scripts/download-agent.ts codex",
    "download:grok": "bun scripts/download-agent.ts grok",
    "download:pi": "bun scripts/download-agent.ts pi",
    "download:binaries": "bun run download:bun && bun run download:claude && bun run download:opencode && bun run download:codex",
    "codex:protocol": "bun scripts/generate-codex-app-server-protocol.ts",
    "codex:protocol:check": "bun scripts/generate-codex-app-server-protocol.ts --check",
    "setup": "bun install && bun run build:claude-bridge && bun run build:codex-bridge && bun run build:acp-bridge && bun run build:pi-bridge && bun run build:cursor-bridge",
    "build:all": "turbo --cwd . run build --cache-dir .turbo",
    "pack:cli": "bun pm pack --cwd packages/cli",
    "smoke:cli": "bun run --cwd packages/cli smoke:pack",
    "publish:cli": "bun run smoke:cli && bun publish --cwd packages/cli --access public",
    "preview": "bun run --cwd apps/web preview",
    "test": "bun scripts/test-all.ts",
    "test:all": "ORKESTRATOR_INCLUDE_IOS=1 bun scripts/test-all.ts",
    "test:logged": "bun scripts/run-logged.ts",
    "typecheck": "turbo --cwd . run typecheck --cache-dir .turbo",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "test:browser": "bunx tsc --noEmit -p e2e/tsconfig.json && playwright test --config e2e/playwright.config.ts",
    "test:agent:browser": "playwright test --config e2e/agent-testing/playwright.browser.config.ts",
    "test:agent:docker": "ORKESTRATOR_AGENT_TEST_DOCKER=1 playwright test --config e2e/agent-testing/playwright.browser.config.ts --grep 'Docker fixture'",
    "test:agent:electron": "playwright test --config e2e/agent-testing/playwright.electron.config.ts",
    "test:ios": "bun scripts/test-ios.ts",
    "test:unit": "bun test tests/unit",
    "verify:opencode:live": "RUN_LIVE_OPENCODE_COMPATIBILITY=1 bun test --cwd apps/web src/lib/opencode-live-compatibility.test.ts",
    "verify:toolchains:live": "RUN_LIVE_TOOLCHAIN_ARTIFACTS=1 bun scripts/verify-toolchain-artifacts.ts",
    "verify:packaged-backend": "bun scripts/verify-packaged-backend.ts",
    "verify:codex:protocol": "CODEX_PROTOCOL_CHECK_ALLOW_MISSING_BINARY=0 bun scripts/generate-codex-app-server-protocol.ts --check",
    "docker:build": "docker build -t orkestrator-v2:latest -f docker/Dockerfile .",
    "docker:build:dev": "bun apps/desktop/scripts/dev-build-image.ts",
    "package": "bun install --frozen-lockfile && bun run download:bun && bun run build:all && bunx electron-builder --dir && bun scripts/install-packaged-app.ts",
    "package:release": "bun install --frozen-lockfile && bun run download:bun && bun run build:all && bunx electron-builder --config electron-builder.release.config.ts && bun scripts/install-packaged-app.ts"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@happy-dom/global-registrator": "^20.1.0",
    "@orkestrator/protocol": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/bun": "~1.4.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/tar-stream": "3.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.18.4",
    "tar-stream": "3.2.0",
    "turbo": "^2.8.20",
    "typescript": "~5.8.3"
  },
  "packageManager": "bun@1.4.0",
  "build": {
    "appId": "com.orkestrator.v2",
    "productName": "OrkestratorV2",
    "directories": {
      "buildResources": "apps/desktop/electron/resources",
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false
    },
    "files": [
      "apps/desktop/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bridges/claude-bridge",
        "to": "claude-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/codex-bridge",
        "to": "codex-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/acp-bridge",
        "to": "acp-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/pi-bridge",
        "to": "pi-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/cursor-bridge",
        "to": "cursor-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "binaries",
        "to": "bin",
        "filter": [
          "bun"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "icons"
    }
  }
}

{
  "name": "pi-bridge",
  "version": "2.34.4-beta",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --external @earendil-works/pi-coding-agent --external @earendil-works/pi-ai --external @earendil-works/pi-agent-core --outfile=dist/index.js && bun run vendor",
    "test:bridge": "bun --no-env-file ../../scripts/bun-test-tier.ts bridges/pi-bridge src -- --preload ../../tests/setup-node.ts --preload ./src/testing/test-isolation.ts --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/pi-bridge.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-1}",
    "vendor": "bun scripts/vendor.ts",
    "typecheck": "bun check && bun check -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@orkestrator/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "~1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2"
  }
}

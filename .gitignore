# Dependencies
node_modules/

# Bun
.bun/
*.bun

# Build outputs
dist/
dist-electron/
# The standalone CLI build stages bridges and their on-demand runtime inputs here.
/packages/cli/resources/
.turbo/
out/
/release/
# Root-anchored: an unanchored `build/` also swallows source directories named
# `build`, such as apps/web/src/components/build.
/build/

# Packaged Bun bootstrap (downloaded only for desktop packaging)
binaries/

# Package outputs
*.tgz
*.dmg
*.exe
*.msi
*.deb
*.rpm
*.snap
!**/__snapshots__/*.snap
*.AppImage

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Core dumps. A host whose kernel.core_pattern is a relative name such as
# `core` writes `core.<pid>` into the crashing process's working directory,
# often a checkout (Playwright's Chromium in the browser suites, for one).
core.[0-9]*

# Coverage
coverage/
.nyc_output/
/output/qualification-*/
/output/contract-backfill/
/output/disposable-docker/
/output/older-release/
/output/playwright/
/output/visual-previews/
/output/pipeline-shots/
/output/agent-testing/
/output/benchmarks/
/output/efficiency/
/output/multi-review-evaluation/
/output/package-security/

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
.tmp/
.temp/

# Context directory (workspace-specific)
.context/

# Claude Code configuration is shared through the repository (settings and
# their safety hooks, skills), except the local release skill.
.claude/skills/release/

# Agent configuration directories (workspace-specific, not shared).
.codex/
.orkestrator/
.orkestrator-linux-home/

src-tauri

.playwright-cli/
.playwright-mcp/
/output/cli-scenarios/

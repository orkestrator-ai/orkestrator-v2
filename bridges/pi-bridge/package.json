{
  "name": "pi-bridge",
  "version": "2.11.7",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --external @earendil-works/pi-coding-agent --external @earendil-works/pi-ai --external @earendil-works/pi-agent-core --outfile=dist/index.js && bun run vendor",
    "vendor": "bun scripts/vendor.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@orkestrator/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "~1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}

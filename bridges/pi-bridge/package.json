{
  "name": "pi-bridge",
  "version": "2.15.4",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --external @earendil-works/pi-coding-agent --external @earendil-works/pi-ai --external @earendil-works/pi-agent-core --outfile=dist/index.js && bun run vendor",
    "test:bridge": "bun test src --preload ../../tests/register-dom.ts --preload ../../tests/setup.ts --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/pi-bridge.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-1}",
    "vendor": "bun scripts/vendor.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-server": "0.85.1",
    "@orkestrator/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "~1.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}

{
  "name": "cursor-bridge",
  "version": "2.34.0-alpha",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --external @cursor/sdk --outfile=dist/index.js && bun run vendor",
    "test:bridge": "bun test src --preload ../../tests/setup-node.ts --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/cursor-bridge.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-1}",
    "vendor": "bun scripts/vendor.ts",
    "typecheck": "bun check && bun check -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.40",
    "@modelcontextprotocol/client": "2.3.1",
    "@orkestrator/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "~1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2"
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "promise"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.1"
    }
  },
  "ignorePatterns": [
    "bridges/codex-bridge/src/app-server/generated/**",
    "test-fixtures/**",
    "output/**",
    "binaries/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-control-regex": "off",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/immutability": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/globals": "warn",
    "react/purity": "warn",
    "react/use-memo": "warn"
  }
}

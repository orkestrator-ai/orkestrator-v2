{
  "name": "claude-bridge",
  "version": "2.11.4",
  "description": "Bridge server for Claude Agent SDK integration with Orkestrator AI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --external @anthropic-ai/claude-agent-sdk --outfile=dist/index.js && bun run vendor",
    "vendor": "bun scripts/vendor.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.245",
    "@anthropic-ai/sdk": "0.120.0",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@orkestrator/protocol": "workspace:*",
    "hono": "^4.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

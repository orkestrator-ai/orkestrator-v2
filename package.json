{
  "name": "orkestrator-ai",
  "version": "2.34.5-beta",
  "private": true,
  "workspaces": [
    "apps/*",
    "bridges/*",
    "packages/*"
  ],
  "type": "module",
  "main": "apps/desktop/dist/electron/main.js",
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@happy-dom/global-registrator": "^21.0.1",
    "@orkestrator/protocol": "workspace:*",
    "@orkestrator/toolchain": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "~1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "3.1.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.1",
    "oxc-parser": "~0.154.0",
    "oxlint": "~1.88.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "4.18.19",
    "tar-stream": "3.2.2",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "packageManager": "bun@1.4.4",
  "build": {
    "appId": "com.orkestrator.v2",
    "productName": "OrkestratorV2",
    "directories": {
      "buildResources": "apps/desktop/electron/resources",
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false
    },
    "files": [
      "apps/desktop/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/backend/dist/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bridges/claude-bridge",
        "to": "claude-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/codex-bridge",
        "to": "codex-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/acp-bridge",
        "to": "acp-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/pi-bridge",
        "to": "pi-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "bridges/cursor-bridge",
        "to": "cursor-bridge",
        "filter": [
          "dist/**",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "binaries",
        "to": "bin",
        "filter": [
          "bun"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSAppleMusicUsageDescription": "Orkestrator checks Music and media-library access at startup so agent searches are not interrupted later.",
        "NSDesktopFolderUsageDescription": "Orkestrator searches project directories on your behalf so agents can work with files on the Desktop.",
        "NSDocumentsFolderUsageDescription": "Orkestrator searches project directories on your behalf so agents can work with files in Documents.",
        "NSDownloadsFolderUsageDescription": "Orkestrator searches project directories on your behalf so agents can work with files in Downloads.",
        "NSPhotoLibraryUsageDescription": "Orkestrator checks Pictures, Movies, and Photos-library access at startup so agent searches are not interrupted later."
      },
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Development",
      "executableName": "orkestrator-v2",
      "icon": "icons",
      "target": [
        "AppImage",
        "pacman"
      ]
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "artifactName": "orkestrator-v2-${os}-${arch}.${ext}"
  },
  "patchedDependencies": {
    "@cursor/sdk@1.2.0": "patches/@cursor%2Fsdk@1.2.0.patch",
    "@opencode-ai/sdk@1.19.5": "patches/@opencode-ai%2Fsdk@1.19.5.patch",
    "react-virtuoso@4.18.19": "patches/react-virtuoso@4.18.19.patch"
  }
}

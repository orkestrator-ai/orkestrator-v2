{
  "name": "@orkestrator/web",
  "version": "2.16.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx tsc && bunx vite build && bun run scripts/precompress.ts",
    "dev": "bunx vite --host 127.0.0.1",
    "dev:web": "bunx vite --host 127.0.0.1",
    "preview": "bunx vite preview",
    "test": "bun test src --parallel",
    "test:workspace": "bun test src --only-failures ${ORKESTRATOR_TEST_TIMINGS_DIR:+--timings=$ORKESTRATOR_TEST_TIMINGS_DIR/web.json --update-timings} --parallel=${ORKESTRATOR_TEST_WORKERS:-2}",
    "typecheck": "bunx tsc --noEmit"
  },
